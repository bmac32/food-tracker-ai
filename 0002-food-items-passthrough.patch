Subject: [PATCH] Pass food_items through to the review card in both photo and
 text analysis paths

---
 app/page.tsx | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/app/page.tsx b/app/page.tsx
index 306b725..6fbfee9 100644
--- a/app/page.tsx
+++ b/app/page.tsx
@@ -164,6 +164,7 @@ export default function Home() {
                 typeof f === "string" ? f : f?.item || "food"
               )
